#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="$(pwd)"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="${BOOTCAMP_ROOT_DIR}/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="${BOOTCAMP_ROOT_DIR}/src"

# The OpenAI Key (Replace with your own key)
export OPENAI_API_KEY="[set in local .env if required]"

# For vllm
export OLLAMA_MODEL="openai/gpt-oss-20b"
export OLLAMA_HOST="localhost"
export OLLAMA_PORT=8124
export QDRANT_HOST="localhost"
export IS_LOCAL="False"
export EMBEDDING_HOST="localhost"
export EMBEDDING_PORT=8123
