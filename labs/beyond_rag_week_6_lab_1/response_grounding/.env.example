#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="$(pwd)"
export PROJECT_ROOT_DIR="${BOOTCAMP_ROOT_DIR}"
export SVRAG_PROJECT_PATH="../sv_rag_pipeline"
#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="${BOOTCAMP_ROOT_DIR}/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="${BOOTCAMP_ROOT_DIR}/src"

# The OpenAI Key (Replace with your own key)
export OPENAI_API_KEY="[set in local .env if required]"

export OLLAMA_MODEL="openai/gpt-oss-20b"
export OLLAMA_HOST="localhost"
export OLLAMA_PORT=8000
export QDRANT_HOST="localhost"
export IS_LOCAL="False"
export EMBEDDING_MODEL="jinaai/jina-embeddings-v2-base-en"
export EMBEDDING_HOST="localhost"
export EMBEDDING_PORT=8000
export SVRAG_SIMILARITY_THRESHOLD=0.7
export SVRAG_TOP_K=5

# Claim extractor LLM (OpenAI-compatible, e.g. Ollama). Optional; defaults shown.
export CLAIM_EXTRACTOR_BASE_URL=http://localhost:8000/v1
export CLAIM_EXTRACTOR_MODEL="openai/gpt-oss-20b"

# Toxicity sanitizer LLM (OpenAI-compatible, e.g. Ollama). Optional; defaults shown.
export TOXICITY_SANITIZE_BASE_URL=http://localhost:8000/v1
export TOXICITY_SANITIZE_MODEL="openai/gpt-oss-20b"

# Response refiner LLM (OpenAI-compatible, e.g. Ollama). Optional; defaults shown.
export RESPONSE_REFINER_BASE_URL=http://localhost:8000/v1
export RESPONSE_REFINER_MODEL="openai/gpt-oss-20b"

# spaCy pipeline for PII NER in PIIGuardrail (optional; default en_core_web_sm).
export PII_SPACY_MODEL=en_core_web_sm

# Cross-encoder NLI model for NLIEntailmentChecker (optional).
export NLI_CROSS_ENCODER_MODEL=cross-encoder/nli-deberta-v3-base

