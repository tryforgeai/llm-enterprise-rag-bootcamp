  "retrieval_questions": [
    {
      "question": "Why can GraphRAG summarize at multiple levels?",
      "answer": "Because knowledge graphs can contain communities within communities. GraphRAG can summarize leaf communities and then summarize parent communities to create multiple abstraction levels."
    },
    {
      "question": "What algorithm does Microsoft GraphRAG use for community detection?",
      "answer": "Microsoft GraphRAG uses the Leiden algorithm to detect communities in the entity graph."
    },
    {
      "question": "How is RAPTOR different from graph community detection?",
      "answer": "RAPTOR clusters chunks by embedding proximity, while graph community detection clusters vertices by relational surplus in the graph."
    }
  ]
