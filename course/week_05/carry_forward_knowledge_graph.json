  "retrieval_questions": [
    {
      "question": "What is the main learning transition in Week 5?",
      "answer": "The transition is from RAG over passages to RAG over structure: graph math, knowledge graph layers, GraphRAG variants, and architecture routing judgment."
    },
    {
      "question": "Why is degree distribution important?",
      "answer": "It diagnoses whether a graph is random-like or real-world-like. Heavy tails and hubs determine whether graph expansion helps navigation or creates retrieval noise."
    },
    {
      "question": "What does Microsoft GraphRAG compute?",
      "answer": "It extracts an entity graph, detects Leiden communities, summarizes communities hierarchically, and uses map-reduce querying for global sensemaking questions."
    },
    {
      "question": "What does MemGraphRAG compute?",
      "answer": "It builds a three-layer graph over passages, facts, and schemas; initializes relevance with Pinit(e), Pinit(t), and Pinit(p); then redistributes semantic energy with personalized PageRank."
    },
    {
      "question": "When should GraphRAG be used as a sidecar?",
      "answer": "Use it for global synthesis over a high-value sub-corpus. Avoid it for point queries, small corpora, and strict real-time latency lanes unless evals prove it pays rent."
    }
  ]
